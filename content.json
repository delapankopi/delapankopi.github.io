/* Product Badge */
.product-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 50px;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    z-index: 2;
}

.badge-bestseller {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #ffffff;
}

.badge-new {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: #ffffff;
}

/* Category Tag di card - style baru */
.product-category-tag {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 50px;
    display: inline-block;
    margin-bottom: 6px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.product-category-tag.badge-bestseller {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #ffffff;
}

.product-category-tag.badge-coffee {
    background: var(--sb-green);
    color: #ffffff;
}

.product-category-tag.badge-noncoffee {
    background: #0288d1;
    color: #ffffff;
}
